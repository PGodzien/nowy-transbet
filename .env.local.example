# Oferty pracy (/kariera) – ta sama baza Supabase co panel /cms na poprzedniej stronie.
# Wartości: Supabase → Project Settings → API (albo ze zmiennych środowiskowych poprzedniej strony).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Panel ofert pracy (/cms) – login i hasło sprawdzane na serwerze (ustaw też w projekcie Vercel).
CMS_USERNAME=twoj-login
CMS_PASSWORD=twoje-haslo

# Tajny klucz serwisowy Supabase (Project Settings → API → service_role). Tylko na serwerze: .env.local i Vercel.
# Z nim CMS zapisuje oferty, a publiczny klucz może mieć w bazie tylko odczyt (docs/supabase-zabezpieczenie.md).
SUPABASE_SERVICE_ROLE_KEY=twoj-klucz-service-role

# Contact form (/api/kontakt): mailbox that sends the messages.
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP AUTH enabled for this mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Formularz transbet.com.pl" <formularz@transbet.com.pl>
